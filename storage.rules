rules_version = '2';

// KNUE Mate Cloud Storage 보안 규칙
//
// 동아리 행사 포스터(club_posters/)만 사용한다. 앱은 Firebase Auth 미사용이라
// 업로드도 무인증이므로, 최소한의 안전장치로 용량(5MB)·이미지 타입만 제한한다.
// 진짜 보안(무단 업로드 차단)은 Phase 3 Auth 도입 후 강화.

service firebase.storage {
  match /b/{bucket}/o {

    match /club_posters/{file} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 그 외 경로는 기본 거부.
  }
}
