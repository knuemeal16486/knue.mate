<?xml version="1.0" encoding="utf-8"?>
<!-- 버스 시간표 위젯. 배경은 식단 위젯(home_widget_layout.xml)과 같은 방식 —
     ImageView에 색·투명도를 입혀 둥근 모서리를 지킨다. 줄 5개는 고정이고
     BusWidgetProvider가 채운다(513·514·518·913 평동행·913 미호행).
     적힌 글은 위젯 고르는 화면의 미리보기용이다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bus_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="학교 출발 버스"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평일"
                android:textSize="11sp"
                android:textColor="#999999"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/bus_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앱을 한 번 열면\n시간표를 불러옵니다."
            android:textSize="13sp"
            android:textColor="#555555"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bus_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_label_0"
                android:text="513"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:paddingEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_times_0"
                android:text="08:50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#555555"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bus_eta_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_label_1"
                android:text="514"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:paddingEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_times_1"
                android:text="09:25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#555555"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bus_eta_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_label_2"
                android:text="518"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:paddingEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_times_2"
                android:text="08:55"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#555555"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bus_eta_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_label_3"
                android:text="913 평동행"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:paddingEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_times_3"
                android:text="09:33"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#555555"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bus_eta_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bus_label_4"
                android:text="913 미호행"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="70dp"
                android:paddingEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/bus_times_4"
                android:text="09:03"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#555555"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bus_eta_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4285F4"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
