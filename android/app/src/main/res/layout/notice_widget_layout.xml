<?xml version="1.0" encoding="utf-8"?>
<!-- 공지 위젯. 배경은 식단 위젯과 같은 방식(ImageView에 색·투명도).
     줄 10개(kNoticeWidgetMaxRows)는 고정이고 NoticeWidgetProvider가 위젯 높이에
     맞는 만큼만 보이게 한다. 보이는 줄은 layout_weight로 높이를 나눠 아래까지 찬다.
     적힌 글은 위젯 고르는 화면의 미리보기용이다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/notice_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/notice_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="공지"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4285F4"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notice_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앱을 한 번 열면\n공지를 불러옵니다."
            android:textSize="13sp"
            android:textColor="#555555"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notice_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="21dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notice_title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[학사공지] 겨울 계절학기 수강신청 안내"
                android:textSize="13sp"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notice_date_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="11/22"
                android:textSize="11sp"
                android:textColor="#999999"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notice_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="21dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notice_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[장학금] 국가장학금 1차 신청 안내"
                android:textSize="13sp"
                android:textColor="#000000"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notice_date_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="11/21"
                android:textSize="11sp"
                android:textColor="#999999"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1" />
