<?xml version="1.0" encoding="utf-8"?>
<!--
  식단·버스·설정 탭처럼 좁은 자리용 압축 네이티브 광고. lib/ad_service.dart가
  팩토리 ID "listTile_compact"로 이 뷰를 찾는다. KnueNativeAdCard의 압축 스폰서
  카드(아이콘+제목/설명 한 줄, 이미지 없음)와 똑같은 모양으로 맞췄다 — 그 카드도
  이미지를 안 쓰므로 미디어뷰를 넣지 않는다.

  뷰 ID는 native_ad_layout.xml(전체 크기)과 그대로 같다 — NativeAdFactoryImpl
  하나가 레이아웃 리소스만 바꿔 끼워서 두 크기를 같이 처리한다.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/native_ad_card_bg"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:background="@drawable/native_ad_icon_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ad_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AD"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/knue_ad_muted_text"
                    android:background="#F3F4F6"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/knue_ad_muted_text"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/knue_ad_brand_blue"
            android:textAllCaps="false"
            android:background="@drawable/native_ad_cta_bg" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
