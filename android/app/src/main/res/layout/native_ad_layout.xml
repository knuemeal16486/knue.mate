<?xml version="1.0" encoding="utf-8"?>
<!--
  스폰서(Firestore sponsors 컬렉션)가 없을 때 대체로 보여줄 네이티브 광고 레이아웃.
  lib/ad_service.dart가 팩토리 ID "listTile"로 이 뷰를 찾는다.
  KnueNativeAdCard(lib/native_ad_card.dart)의 압축(isCompact) 카드와 같은
  느낌(둥근 카드, AD 배지, 아이콘+제목/설명, 알약 버튼)으로 맞췄다.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/native_ad_card_bg"
        android:padding="16dp">

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AD"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:background="#F3F4F6"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:background="@drawable/native_ad_icon_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 구글 네이티브 광고 정책: 비디오를 정상 표시하려면 최소 120x120dp가
             필요하다. 너비는 match_parent라 항상 충분하지만 높이가 부족하면
             "MediaView is too small to display video" 경고가 뜬다. -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:textAllCaps="false"
            android:background="@drawable/native_ad_cta_bg" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
