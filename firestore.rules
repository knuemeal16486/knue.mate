rules_version = '2';

// KNUE Mate Firestore 보안 규칙
//
// ⚠️ 중요: 이 앱은 현재 Firebase Auth를 사용하지 않는다. 식단/평점/버스/건물/
// 실시간/공지/동아리 행사 모두 "로그인하지 않은 클라이언트"가 직접 읽고 쓴다.
// 따라서 규칙만으로는 무단 쓰기를 막을 수 없다(막으면 앱 기능이 깨진다).
//
// 이 규칙의 목표는 (1) 앱 동작 유지, (2) 만료되는 test-mode 규칙 제거(영구),
// (3) 관리자 비밀번호 문서는 콘솔에서만 쓰도록 잠금, (4) 정의되지 않은 경로는
// 기본 거부(default-deny) 다. 진짜 보안(무단 쓰기 차단)은 Firebase Auth 도입
// (Phase 3) 후 관리자 식별로 강화한다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 관리자 설정 ─────────────────────────────────────────────
    // 앱이 클라이언트에서 비밀번호를 읽어 비교하므로 read 허용이 불가피하다.
    // ⚠️ 비밀번호가 클라이언트에 노출되므로 중요한 비밀번호를 재사용하지 말 것.
    // 쓰기는 콘솔(관리 권한, 규칙 우회)에서만 → 클라이언트 변조 방지.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── 동아리 공연/행사 ────────────────────────────────────────
    // 학생 열람(read). 등록/수정은 앱 관리자 화면(무인증 클라이언트)에서 write.
    // ⚠️ 무인증 write — 클라이언트 비번 게이트는 UX일 뿐. Phase 3에서 Auth로 강화.
    match /club_events/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ── 제휴 / 네이티브 광고 ───────────────────────────────────
    // club_events와 같은 사정: 인앱 관리 화면이 아직 없어(현재는
    // tool/seed_sponsor.dart로 직접 write) 무인증 write가 불가피하다.
    // ⚠️ 광고는 외부 링크로 연결되므로 club_events보다 악용 시 피해가 크다
    // (피싱 링크 주입 가능). Phase 3에서 Auth 붙이면 가장 먼저 잠글 것.
    match /sponsors/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ── 기존 앱 데이터 (동작 유지) ──────────────────────────────
    // 모두 무인증 클라이언트가 읽고 쓴다. 하위 문서까지 포함(=**).
    match /daily_meals/{doc=**}    { allow read, write: if true; }
    match /meal_ratings/{doc=**}   { allow read, write: if true; }
    match /bus_timetables/{doc=**} { allow read, write: if true; }
    match /bus_stops/{doc=**}      { allow read, write: if true; }
    match /realtime/{doc=**}       { allow read, write: if true; }
    match /knue_buildings/{doc=**} { allow read, write: if true; }
    match /notices/{doc=**}        { allow read, write: if true; }

    // ── 자취방 시세 제보 ────────────────────────────────────────
    // 학생이 직접 남기는 제보라 무인증 create가 필요하다.
    // 다만 남의 제보를 고치거나 지우지는 못하게 update/delete는 막는다 —
    // 시세는 여러 사람의 기록이 쌓여야 의미가 있는데, 누구나 수정할 수 있으면
    // 한 사람이 통째로 바꿔놓을 수 있다.
    match /housing_reports/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ── 자취방 건물 정보 관리자 덮어쓰기 ───────────────────────
    // 건물 이름·구역은 기본적으로 학생 제보 다수결로 정해지는데,
    // 관리자가 housing_admin_screen.dart에서 바로잡은 값이 여기 저장된다.
    match /housing_building_overrides/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // ── 캠퍼스맵 관리자 위치 ────────────────────────────────────
    // club_events와 같은 사정 — 앱 내 비밀번호 게이트로만 보호되는
    // 무인증 write. 개발자 모드에서 지도를 길게 눌러 추가/삭제한다.
    match /admin_map_facilities/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // 그 외 경로는 명시하지 않아 기본 거부(default-deny).
  }
}
