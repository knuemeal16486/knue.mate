rules_version = '2';

// KNUE Mate Firestore 보안 규칙
//
// ## 모델
//
// - 모든 사용자는 **익명 로그인**한다(`AdminAuthService.initialize()`).
//   학생 제보·별점·공용 캐시처럼 누구나 하는 쓰기는 "로그인되어 있을 것"과
//   기본 스키마·크기 검증을 요구한다. 앱을 거치지 않는 외부 스크립트와
//   비정상 페이로드 주입을 막는 최소선이다.
// - 관리자 쓰기(행사·제휴·지도 위치·건물 목록·자취방 보정·앱 설정)는
//   `admin_grants/{uid}` 문서가 있는 기기만 할 수 있다.
// - 그 grant는 비밀번호를 아는 사람만 만들 수 있다. 대조는 **여기 규칙이
//   서버에서** 하므로 클라이언트는 정답을 읽지 못한다.
//
// ## ✅ 2단계 적용 완료
//
// - `studentWrite()`가 `signedIn()`으로 전환되어 미인증 쓰기를 모두 차단한다.
// - 학생 제보(`housing_reports`)와 별점(`meal_ratings`), 그리고 공용 캐시
//   컬렉션에 필드 화이트리스트·타입·길이/개수 검증을 적용했다.
// - 캠퍼스 건물 데이터(`knue_buildings`) 동기화가 학생 기기에서 관리자 메뉴로
//   이전됨에 따라 쓰기 권한을 `isAdmin()`으로 잠갔다.
// - 공용 캐시 컬렉션의 삭제(`delete`)는 관리자만 가능하도록 제한했다.
//
// ## 예전 상태와 달라진 점
//
// 예전엔 모든 컬렉션이 `allow write: if true`였고, 관리자 비밀번호 문서마저
// 누구나 읽을 수 있었다. 1단계에서 관리자 컬렉션·비밀번호를 먼저 잠갔고,
// 이제 2단계에서 익명 로그인 강제·페이로드 검증·건물 데이터 쓰기 잠금까지
// 마무리했다.
//
// ## 비밀번호를 바꾸려면
//
// 콘솔에서 `app_config/admin`의 password를 바꾸고, 기존 `admin_grants`
// 문서를 지우면 모든 기기의 권한이 한 번에 풀린다.
//
// ===============================================================
// Assumed Data Model (추정 데이터 모델)
// ===============================================================
//
// - app_config/{doc}                 : 관리자 비밀번호 등 서버 전용 비밀값 (읽기/쓰기 전면 차단)
// - app_settings/{doc}               : 공개 앱 설정 (home_greeting, app_version, exit_promo, housing_data, notice_feed)
// - admin_grants/{uid}               : { token: string, grantedAt?: timestamp } (본인 get/create/delete만 허용, update/list 금지)
// - club_events/{doc}                : 동아리/행사 정보 (읽기 공개, 쓰기 관리자)
// - sponsors/{doc}                   : 제휴/광고 카드 및 외부 링크 (읽기 공개, 쓰기 관리자)
// - admin_map_facilities/{doc}       : 캠퍼스 지도 시설 마커 (읽기 공개, 쓰기 관리자)
// - housing_building_overrides/{doc} : 자취방 건물 정보 보정 (읽기 공개, 쓰기 관리자)
// - housing_custom_buildings/{doc}   : 개발자 모드 추가/병합 건물 도형 (읽기 공개, 쓰기 관리자)
// - housing_landmarks/{doc}          : 자취방 지도 정류장/출입문 랜드마크 (읽기 공개, 쓰기 관리자)
// - notices/{doc=**}                 : 식단 상단 공지 배너 (읽기 공개, 쓰기 관리자)
// - knue_buildings/{doc=**}          : 캠퍼스 건물·층별 시설 정보 (읽기 공개, 쓰기 관리자)
// - housing_reports/{doc}            : 자취방 시세/연락처 제보
//     required: buildingId(string<=200), deposit(0..100000), monthlyRent(0..10000),
//               features(list<=30), reportedAt(timestamp)
//     optional: maintenanceFee(0..1000), oneRoomId(string<=100),
//               roomType('oneRoom'|'onePointFive'|'twoRoom'|'threeRoomPlus'),
//               review(string<=500), contactPhone(string<=200),
//               drawbacks(list<=30), includedUtilities(list<=30)
// - meal_ratings/{doc=**}            : 식단 별점·배식 방식 투표 (신규 add + 레거시 set)
//     required: date(YYYY-MM-DD), source('a'|'b'), mealType('breakfast'|'lunch'|'dinner'), rating(0.5..5.0)
//     optional: fingerPrint(string<=128), servingStyle('self'|'fixed'), createdAt(timestamp), ratedAt(timestamp)
// - daily_meals/{doc=**}             : { date, source, meals(map), lastUpdated(timestamp), cacheVersion? }
// - bus_timetables/{doc=**}          : { routeNumber, isOutgoing, isWeekday, departureTimes(list<=300), lastUpdated }
// - bus_stops/{doc=**}               : { nodeId, nodeName, nodeNo?, latitude, longitude, nodeOrd, routeNumber, lastUpdated }
// - realtime/{doc=**}                : { lastUpdated(timestamp), summaries(list<=50) }
// - academic_calendar/{doc=**}       : { academicYear?, events?(list<=500), fetchedAt?, refreshingUntil? }
// - calorie_cache/{doc=**}           : { calories(string<=200), menu(string<=2000), createdAt(timestamp) }
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 인증·권한 헬퍼 ─────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 학생이 하는 쓰기(별점·제보)와 앱이 채우는 공용 캐시의 조건.
    // 2단계: 익명 로그인(AdminAuthService.initialize())된 앱 요청만 허용한다.
    function studentWrite() {
      return signedIn();
    }

    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admin_grants/$(request.auth.uid));
    }

    // ── 공통 검증 헬퍼 ──────────────────────────────────────────

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data)
             || data[field] == null
             || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumberInRange(data, field, minVal, maxVal) {
      return !(field in data)
             || data[field] == null
             || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalList(data, field, maxSize) {
      return !(field in data)
             || data[field] == null
             || (data[field] is list && data[field].size() <= maxSize);
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data)
             || data[field] == null
             || data[field] is timestamp;
    }

    // ── 도메인 페이로드 검증기 ──────────────────────────────────

    function isValidAdminGrant(data) {
      return data.keys().hasOnly(['token', 'grantedAt'])
             && data.keys().hasAll(['token'])
             && data.token is string
             && data.token.size() > 0
             && data.token.size() <= 200
             && isOptionalTimestamp(data, 'grantedAt');
    }

    function isValidHousingReport(data) {
      return data.keys().size() <= 20
             && data.keys().hasOnly([
               'buildingId',
               'deposit',
               'monthlyRent',
               'maintenanceFee',
               'oneRoomId',
               'roomType',
               'review',
               'contactPhone',
               'drawbacks',
               'includedUtilities',
               'features',
               'reportedAt'
             ])
             && data.keys().hasAll([
               'buildingId',
               'deposit',
               'monthlyRent',
               'features',
               'reportedAt'
             ])
             && data.buildingId is string
             && data.buildingId.size() > 0
             && data.buildingId.size() <= 200
             && data.deposit is number
             && data.deposit >= 0
             && data.deposit <= 100000
             && data.monthlyRent is number
             && data.monthlyRent >= 0
             && data.monthlyRent <= 10000
             && data.features is list
             && data.features.size() <= 30
             && data.reportedAt is timestamp
             && isOptionalNumberInRange(data, 'maintenanceFee', 0, 1000)
             && isOptionalString(data, 'oneRoomId', 100)
             && (!('roomType' in data)
                 || data.roomType == null
                 || (data.roomType is string
                     && data.roomType in ['oneRoom', 'onePointFive', 'twoRoom', 'threeRoomPlus']))
             && isOptionalString(data, 'review', 500)
             && isOptionalString(data, 'contactPhone', 200)
             && isOptionalList(data, 'drawbacks', 30)
             && isOptionalList(data, 'includedUtilities', 30);
    }

    function isValidMealRating(data) {
      return data.keys().size() <= 10
             && data.keys().hasOnly([
               'fingerPrint',
               'date',
               'source',
               'mealType',
               'rating',
               'servingStyle',
               'createdAt',
               'ratedAt'
             ])
             && data.keys().hasAll(['date', 'source', 'mealType', 'rating'])
             && data.date is string
             && data.date.size() == 10
             && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && data.source is string
             && data.source in ['a', 'b']
             && data.mealType is string
             && data.mealType in ['breakfast', 'lunch', 'dinner']
             && data.rating is number
             && data.rating >= 0.5
             && data.rating <= 5.0
             && isOptionalString(data, 'fingerPrint', 128)
             && (!('servingStyle' in data)
                 || data.servingStyle == null
                 || (data.servingStyle is string
                     && data.servingStyle in ['self', 'fixed']))
             && isOptionalTimestamp(data, 'createdAt')
             && isOptionalTimestamp(data, 'ratedAt');
    }

    function isValidDailyMealCache(data) {
      return data.keys().size() <= 10
             && data.keys().hasOnly(['date', 'source', 'meals', 'lastUpdated', 'cacheVersion'])
             && data.keys().hasAll(['date', 'source', 'meals', 'lastUpdated'])
             && data.date is string
             && data.date.size() > 0
             && data.date.size() <= 20
             && data.source is string
             && data.source in ['a', 'b']
             && data.meals is map
             && data.meals.keys().size() <= 10
             && data.lastUpdated is timestamp
             && isOptionalNumberInRange(data, 'cacheVersion', 1, 100);
    }

    function isValidBusTimetableCache(data) {
      return data.keys().size() <= 10
             && data.keys().hasOnly([
               'routeNumber',
               'isOutgoing',
               'isWeekday',
               'departureTimes',
               'lastUpdated'
             ])
             && data.keys().hasAll([
               'routeNumber',
               'isOutgoing',
               'isWeekday',
               'departureTimes',
               'lastUpdated'
             ])
             && data.routeNumber is string
             && data.routeNumber.size() > 0
             && data.routeNumber.size() <= 30
             && data.isOutgoing is bool
             && data.isWeekday is bool
             && data.departureTimes is list
             && data.departureTimes.size() <= 300
             && data.lastUpdated is timestamp;
    }

    function isValidBusStopCache(data) {
      return data.keys().size() <= 15
             && data.keys().hasOnly([
               'nodeId',
               'nodeName',
               'nodeNo',
               'latitude',
               'longitude',
               'nodeOrd',
               'routeNumber',
               'lastUpdated'
             ])
             && data.keys().hasAll([
               'nodeId',
               'nodeName',
               'latitude',
               'longitude',
               'nodeOrd',
               'routeNumber',
               'lastUpdated'
             ])
             && data.nodeId is string
             && data.nodeId.size() <= 100
             && data.nodeName is string
             && data.nodeName.size() <= 200
             && isOptionalString(data, 'nodeNo', 50)
             && data.latitude is number
             && data.longitude is number
             && data.nodeOrd is number
             && data.routeNumber is string
             && data.routeNumber.size() > 0
             && data.routeNumber.size() <= 30
             && data.lastUpdated is timestamp;
    }

    function isValidRealtimeCache(data) {
      return data.keys().size() <= 10
             && data.keys().hasOnly(['lastUpdated', 'summaries'])
             && data.keys().hasAll(['lastUpdated', 'summaries'])
             && data.lastUpdated is timestamp
             && data.summaries is list
             && data.summaries.size() <= 50;
    }

    function isValidAcademicCalendarCache(data) {
      return data.keys().size() >= 1
             && data.keys().size() <= 10
             && data.keys().hasOnly(['academicYear', 'events', 'fetchedAt', 'refreshingUntil'])
             && isOptionalNumberInRange(data, 'academicYear', 2000, 2100)
             && isOptionalList(data, 'events', 500)
             && isOptionalTimestamp(data, 'fetchedAt')
             && isOptionalTimestamp(data, 'refreshingUntil');
    }

    function isValidCalorieCache(data) {
      return data.keys().size() <= 10
             && data.keys().hasOnly(['calories', 'menu', 'createdAt'])
             && data.keys().hasAll(['calories', 'menu', 'createdAt'])
             && data.calories is string
             && data.calories.size() > 0
             && data.calories.size() <= 200
             && data.menu is string
             && data.menu.size() > 0
             && data.menu.size() <= 2000
             && data.createdAt is timestamp;
    }

    // ── 관리자 비밀번호 ─────────────────────────────────────────
    // 읽기까지 막는다. 규칙 안의 get()은 규칙을 우회하므로 대조는 계속 된다.
    // 값은 Firebase 콘솔에서만 넣고 바꾼다.
    match /app_config/{doc} {
      allow read, write: if false;
    }

    // ── 앱 공용 설정 ────────────────────────────────────────────
    // 관리자가 앱 안에서 켜고 끄거나 콘솔에서 조절하는 공개 설정
    // (예: exit_promo, home_greeting, app_version, housing_data, notice_feed).
    // 위의 app_config와 헷갈리기 쉬운데 성격이 정반대다:
    //   app_config   = 비밀번호. 아무도 못 읽는다.
    //   app_settings = 공개 설정. 모든 앱이 읽어야 화면이 맞춰진다.
    // 그래서 읽기는 열고 쓰기만 관리자로 막는다.
    match /app_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 관리자 권한 부여 ────────────────────────────────────────
    // 비밀번호를 아는 사람이 자기 uid로 문서를 만든다.
    //
    // 문서에는 대조에 쓴 token이 그대로 남는다. 자기 문서만 읽을 수 있으므로
    // 남에게 새지는 않는다 — 어차피 그 비밀번호를 방금 입력한 기기다.
    // 목록 조회(list)는 막는다. 열어 두면 uid를 훑어 token을 긁어갈 수 있다.
    match /admin_grants/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
                    && isValidAdminGrant(request.resource.data)
                    && request.resource.data.token
                       == get(/databases/$(database)/documents/app_config/admin).data.password;
      // 한번 만든 grant는 고칠 수 없고, 본인 기기에서 내려놓는 것만 된다.
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // ── 관리자만 쓰는 것들 ──────────────────────────────────────
    // 행사·제휴·지도 위치·건물 목록·자취방 건물 보정. 읽기는 누구나(앱 화면에 쓰인다).
    match /club_events/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ⚠️ 외부 링크가 붙는다 — 피싱 통로가 될 수 있어 특히 단단히 잠근다.
    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_map_facilities/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /housing_building_overrides/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 개발자 모드에서 새로 그리거나 여러 동을 합친 건물의 모양.
    // 규칙이 없어서 기본 거부에 걸렸고, 추가·병합이 화면에서만 되고
    // 저장은 조용히 실패해 앱을 다시 켜면 사라졌다.
    match /housing_custom_buildings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 개발자 모드에서 자취방 지도에 찍는 버스정류장·정문·후문·쪽문 위치.
    match /housing_landmarks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 식단 화면 위에 모든 사용자에게 뜨는 공지 배너(관리자가 콘솔에서 쓴다).
    // 공용 캐시가 아니다 — 앱은 읽기만 한다. 예전엔 학생도 쓸 수 있어서 누구나
    // 모든 사용자 화면에 배너를 띄울 수 있었다(2026-10-08 막음).
    match /notices/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 캠퍼스 건물·층별 시설 정보. 예전엔 학생 기기가 앱 시작 시 동기화했으나
    // 관리자 메뉴로 이전되어 이제 관리자만 쓸 수 있다.
    match /knue_buildings/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 자취방 시세 제보 ────────────────────────────────────────
    // 학생이 직접 남기므로 create는 익명 로그인(studentWrite()) + 스키마 검증을 요구한다.
    // 남의 제보를 고치거나 지우는 건 관리자만 — 시세는 여러 사람의 기록이
    // 쌓여야 의미가 있는데 누구나 고칠 수 있으면 한 사람이 통째로 바꿔놓는다.
    // (예전엔 update/delete가 통째로 막혀 있어서 관리자 화면의 수정·삭제
    //  버튼이 항상 실패했다.)
    match /housing_reports/{doc} {
      allow read: if true;
      allow create: if studentWrite()
                    && isValidHousingReport(request.resource.data);
      allow update: if isAdmin()
                    && isValidHousingReport(request.resource.data)
                    && areImmutableFieldsUnchanged(['buildingId', 'reportedAt']);
      allow delete: if isAdmin();
    }

    // ── 학생이 남기는 값 ────────────────────────────────────────
    // 별점은 두 방식이 섞여 있다: 개인별 문서를 add()하는 쪽(fingerPrint 있음)과,
    // 끼니당 한 문서를 set()으로 덮어쓰는 옛 경로(fingerPrint 없음).
    // 후자 때문에 update를 허용하되, 개인별 문서(fingerPrint 있음)의 변조는 막고
    // 레거시 문서만 핵심 키(date/source/mealType)를 유지한 채 갱신할 수 있게 한다.
    // 지우는 건 관리자만 — 남의 별점을 지울 이유가 학생에게는 없다.
    match /meal_ratings/{doc=**} {
      allow read: if true;
      allow create: if studentWrite()
                    && isValidMealRating(request.resource.data);
      allow update: if (isAdmin() && isValidMealRating(request.resource.data))
                    || (studentWrite()
                        && !('fingerPrint' in resource.data)
                        && isValidMealRating(request.resource.data)
                        && areImmutableFieldsUnchanged(['date', 'source', 'mealType']));
      allow delete: if isAdmin();
    }

    // ── 앱이 채우는 공용 캐시 ───────────────────────────────────
    // 한 기기가 받아온 걸 나눠 쓰는 용도라 익명 로그인된 앱이면 생성·갱신할 수 있다.
    // 삭제는 관리자만 허용하고, 각 컬렉션의 허용 필드·크기 한도를 검증한다.
    match /daily_meals/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidDailyMealCache(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bus_timetables/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidBusTimetableCache(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bus_stops/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidBusStopCache(request.resource.data);
      allow delete: if isAdmin();
    }

    match /realtime/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidRealtimeCache(request.resource.data);
      allow delete: if isAdmin();
    }

    // 학사일정 학년도별 1년치(academic_calendar/{학년도}). 기기 한 대가 하루에
    // 한 번 학교에서 받아 모두가 나눠 쓴다 — 학교 서버 부담 때문(2026-09-28).
    match /academic_calendar/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidAcademicCalendarCache(request.resource.data);
      allow delete: if isAdmin();
    }

    // Gemini 칼로리 추정 캐시. 규칙이 아예 없어서 기본 거부에 걸렸고,
    // 그래서 캐시가 한 번도 쌓이지 않아 매번 Gemini를 다시 불렀다.
    match /calorie_cache/{doc=**} {
      allow read: if true;
      allow create, update: if studentWrite()
                            && isValidCalorieCache(request.resource.data);
      allow delete: if isAdmin();
    }

    // 그 외 경로는 명시하지 않아 기본 거부(default-deny).
  }
}
