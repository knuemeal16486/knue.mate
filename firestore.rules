rules_version = '2';

// KNUE Mate Firestore 보안 규칙
//
// ## 모델
//
// - 모든 사용자는 **익명 로그인**한다. 학생 제보·별점처럼 누구나 하는 쓰기는
//   "로그인되어 있을 것"만 요구한다. 앱을 거치지 않는 외부 스크립트를 막는
//   최소선이고, 완벽한 신원 확인은 아니다(익명 계정은 누구나 만들 수 있다).
// - 관리자 쓰기(행사·제휴·지도 위치·자취방 보정)는 `admin_grants/{uid}`
//   문서가 있는 기기만 할 수 있다.
// - 그 grant는 비밀번호를 아는 사람만 만들 수 있다. 대조는 **여기 규칙이
//   서버에서** 하므로 클라이언트는 정답을 읽지 못한다.
//
// ## 예전 상태와 달라진 점
//
// 예전엔 모든 컬렉션이 `allow write: if true`였고, 관리자 비밀번호 문서마저
// 누구나 읽을 수 있었다. 즉 비밀번호는 공개였고, 애초에 쓰기에 인증이 없어
// 비밀번호가 필요하지도 않았다. sponsors에는 외부 링크가 붙어서 누구나
// 피싱 링크를 심을 수 있는 상태였다.
//
// ## 비밀번호를 바꾸려면
//
// 콘솔에서 `app_config/admin`의 password를 바꾸고, 기존 `admin_grants`
// 문서를 지우면 모든 기기의 권한이 한 번에 풀린다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admin_grants/$(request.auth.uid));
    }

    // ── 관리자 비밀번호 ─────────────────────────────────────────
    // 읽기까지 막는다. 규칙 안의 get()은 규칙을 우회하므로 대조는 계속 된다.
    // 값은 Firebase 콘솔에서만 넣고 바꾼다.
    match /app_config/{doc} {
      allow read, write: if false;
    }

    // ── 관리자 권한 부여 ────────────────────────────────────────
    // 비밀번호를 아는 사람이 자기 uid로 문서를 만든다. 저장된 token이
    // 새어나가지 않도록 읽기를 막는다(앱도 읽을 필요가 없다 — 존재 여부는
    // exists()로 규칙이 판단하고, 앱은 get 실패를 권한 없음으로 처리한다).
    match /admin_grants/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.token
                       == get(/databases/$(database)/documents/app_config/admin).data.password;
      // 한번 만든 grant는 고칠 수 없고, 본인 기기에서 내려놓는 것만 된다.
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── 관리자만 쓰는 것들 ──────────────────────────────────────
    // 행사·제휴·지도 위치·자취방 건물 보정. 읽기는 누구나(앱 화면에 쓰인다).
    match /club_events/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ⚠️ 외부 링크가 붙는다 — 피싱 통로가 될 수 있어 특히 단단히 잠근다.
    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_map_facilities/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /housing_building_overrides/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 자취방 시세 제보 ────────────────────────────────────────
    // 학생이 직접 남기므로 create는 로그인만 요구한다.
    // 남의 제보를 고치거나 지우는 건 관리자만 — 시세는 여러 사람의 기록이
    // 쌓여야 의미가 있는데 누구나 고칠 수 있으면 한 사람이 통째로 바꿔놓는다.
    // (예전엔 update/delete가 통째로 막혀 있어서 관리자 화면의 수정·삭제
    //  버튼이 항상 실패했다.)
    match /housing_reports/{doc} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ── 학생이 남기는 값 ────────────────────────────────────────
    // 별점은 두 방식이 섞여 있다: 개인별 문서를 add()하는 쪽과, 끼니당 한
    // 문서를 set()으로 덮어쓰는 옛 경로. 후자 때문에 update까지 열어야 한다
    // (create만 열면 그 끼니의 두 번째 별점부터 전부 거부된다).
    // 지우는 건 관리자만 — 남의 별점을 지울 이유가 학생에게는 없다.
    match /meal_ratings/{doc=**} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ── 앱이 채우는 공용 캐시 ───────────────────────────────────
    // 한 기기가 받아온 걸 나눠 쓰는 용도라 로그인한 앱이면 쓸 수 있다.
    // 지워지면 다시 채워지는 값들이라 손실 위험이 낮다.
    match /daily_meals/{doc=**}    { allow read: if true; allow write: if signedIn(); }
    match /knue_buildings/{doc=**} { allow read: if true; allow write: if signedIn(); }
    match /bus_timetables/{doc=**} { allow read: if true; allow write: if signedIn(); }
    match /bus_stops/{doc=**}      { allow read: if true; allow write: if signedIn(); }
    match /realtime/{doc=**}       { allow read: if true; allow write: if signedIn(); }
    match /notices/{doc=**}        { allow read: if true; allow write: if signedIn(); }

    // Gemini 칼로리 추정 캐시. 규칙이 아예 없어서 기본 거부에 걸렸고,
    // 그래서 캐시가 한 번도 쌓이지 않아 매번 Gemini를 다시 불렀다.
    match /calorie_cache/{doc=**}  { allow read: if true; allow write: if signedIn(); }

    // 그 외 경로는 명시하지 않아 기본 거부(default-deny).
  }
}
